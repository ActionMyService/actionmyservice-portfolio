# Database — SQLite for local dev (default), PostgreSQL for production
# Example PostgreSQL (Supabase/Neon):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# JWT secret for admin authentication — change in production!
JWT_SECRET="actionmyservice-super-secret-jwt-key-change-in-production"

# Admin credentials (used by prisma/seed.ts to create the admin user)
ADMIN_EMAIL="admin@actionmyservice.com"
ADMIN_PASSWORD="ActionMyService2026!"

# Public site URL (used for sitemap, canonical URLs, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"